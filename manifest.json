{
  "manifest_version": 3,
  "name": "Colab Menu Automation",
  "version": "1.0",
  "description": "Automate Colab menu actions: delete runtime, change to T4 GPU, open notebook by name",
  "permissions": ["storage", "activeTab", "downloads", "scripting"],
  "host_permissions": ["https://colab.research.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://colab.research.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colab Menu Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
